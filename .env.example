# Valores FICTICIOS para desarrollo local. Copia este archivo a .env (ignorado por git).
# Nunca pongas aquí valores reales ni datos de invitados.

# --- Postgres local (compose) ---
POSTGRES_USER=ma_local
POSTGRES_PASSWORD=__CAMBIAR_SOLO_LOCAL__
POSTGRES_DB=ma_wedding_local

# --- API ---
LOG_LEVEL=INFO
INVITATION_ORIGIN=http://localhost:8080

# --- Se usan a partir de fases posteriores (doc 11 de arquitectura) ---
# MIGRATION_DATABASE_URL=__CAMBIAR__          # I-2
# TOKEN_HASH_KEY=__CAMBIAR__                  # I-3
# TOKEN_ENCRYPTION_KEYS=__CAMBIAR__           # I-3
# SESSION_SECRET=__CAMBIAR__                  # I-6
# GOOGLE_CLIENT_ID=__CAMBIAR__                # I-6
# GOOGLE_CLIENT_SECRET=__CAMBIAR__            # I-6
# ADMIN_EMAILS_NOVIOS=novia@ejemplo.invalid,novio@ejemplo.invalid   # I-6
# ADMIN_EMAILS_PLANNER=planner@ejemplo.invalid                      # I-6
