# Valores FICTICIOS para desarrollo local. Copia este archivo a .env (ignorado por git).
# Nunca pongas aquí valores reales ni datos de invitados.

# --- Postgres local (compose) ---
# Superusuario de arranque: solo lo usa el script db/init/01-roles.sh.
POSTGRES_USER=ma_local
POSTGRES_PASSWORD=__CAMBIAR_SOLO_LOCAL__
POSTGRES_DB=ma_wedding_local

# Usuario de MIGRACIONES (dueño del esquema; solo `migrate`) — ADR 0019
DB_MIGRATOR_USER=ma_migrator
DB_MIGRATOR_PASSWORD=__CAMBIAR_MIGRATOR_LOCAL__

# Usuario de EJECUCIÓN (solo datos) — ADR 0019
DB_RUNTIME_ROLE=ma_app
DB_APP_PASSWORD=__CAMBIAR_APP_LOCAL__

# compose arma DATABASE_URL y MIGRATION_DATABASE_URL con los valores de arriba.

# --- API ---
LOG_LEVEL=INFO
# Base del enlace https://<dominio>/#t=<token>. Local: http://localhost:8080.
# Pruebas en la nube: https://ma-wedding-six.vercel.app. NINGÚN enlace real se envía a
# invitados hasta definir el dominio definitivo (el dominio queda dentro de cada enlace).
INVITATION_ORIGIN=http://localhost:8080

# --- Llaves de tokens (ADR 0019) ---
# NUNCA se escriben aquí. Genéralas en tu .env (no imprime los valores):
#   cd api && uv run python -m app generar-llaves --env-file ../.env
TOKEN_HASH_KEY=__GENERAR__
TOKEN_ENCRYPTION_KEYS=__GENERAR__
# Solo durante una rotación de la llave de hash (ver doc 11):
# TOKEN_HASH_KEY_PREVIOUS=

# --- API pública: límites (ADR 0019; valores iniciales) ---
RATE_LIMIT_TOKEN_LOOKUP_PER_HOUR=20
RATE_LIMIT_TOKEN_RESPONSE_PER_HOUR=10
RATE_LIMIT_IP_PER_HOUR=300
MAX_BODY_PUBLIC=4096
# HSTS solo con el dominio definitivo (ADR 0019 y 0021).
SECURITY_HSTS=false
# Proxies delante de la API que AGREGAN la IP del cliente a X-Forwarded-For (I-10, ADR 0030).
# 0 = ninguno (desarrollo). El modo «como producción» y Render usan 1. Reemplaza a
# FORWARDED_ALLOW_IPS: la IP se cuenta desde la DERECHA (lo de la izquierda lo escribe el cliente).
TRUSTED_PROXY_HOPS=0

# --- Panel: login con Google (I-6; ADR 0005, 0015, doc 06) ---
# Origen público de la API y del panel (la URI de redirección es
# <PANEL_ORIGIN>/api/v1/auth/google/callback y debe estar registrada en Google Cloud).
PANEL_ORIGIN=http://localhost:8000
# Carpeta del build del panel (I-9). La imagen Docker ya lo trae en /srv/panel y fija esta
# variable; solo cámbiala si corres la API fuera de Docker (p. ej. ../panel/dist).
# PANEL_DIR=/srv/panel
# Cliente OAuth "Aplicación web" que crea Mayra en Google Cloud. El secreto NUNCA va aquí:
# pégalo solo en tu .env.
GOOGLE_CLIENT_ID=__CAMBIAR__.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=__CAMBIAR__
# Lo genera `generar-llaves --env-file ../.env` sin mostrarlo:
SESSION_SECRET=__GENERAR__
# Listas de correos por rol, separadas por comas. En tu .env van los correos reales;
# aquí solo ficticios. Un correo no puede estar en las dos listas.
ADMIN_EMAILS_NOVIOS=novia@ejemplo.invalid,novio@ejemplo.invalid
ADMIN_EMAILS_PLANNER=planner@ejemplo.invalid
# Sesión: cierre por inactividad (horas) y duración máxima (días).
SESION_INACTIVIDAD_HORAS=8
SESION_MAXIMA_DIAS=7
MAX_BODY_ADMIN=65536

# --- Respaldos (I-10; doc 10, ADR 0030) ---
# Llave PÚBLICA de age (age1…). Genera el par FUERA del repo (ver docs/operacion/):
# la llave privada nunca va en este archivo ni en el proveedor.
BACKUP_AGE_RECIPIENT=
# Destino: una carpeta (el modo «como producción» la fija en /srv/respaldos) O bien S3/R2.
# BACKUP_DIR=
# En producción (R2): endpoint https://<cuenta>.r2.cloudflarestorage.com, región auto y un
# token con acceso solo a ese bucket. NUNCA pongas aquí llaves reales.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# --- Alertas (Healthchecks; I-10, ADR 0030) ---
# Vacías = alertas apagadas. En producción, la URL de ping de cada tarea (es secreta).
ALERT_PING_URL_BACKUP=
ALERT_PING_URL_PURGE=
